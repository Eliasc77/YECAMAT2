managed implementation in class zbp_i_dm_solicitud unique;
strict ( 2 );
with draft;

define behavior for ZI_DM_SOLICITUD alias Solicitud
persistent table zdm_sol_cab
draft table zdm_sol_cab_d
lock master total etag ModificadoEl
authorization master ( global )
etag master ModificadoTotalEl
{
  create;
  update;

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare { }

  field ( readonly, numbering : managed ) IdSolicitud;
  field ( readonly ) Estado, InicioParalelo, MaterialResultado,
                     CreadoPor, CreadoEl, ModificadoPor, ModificadoEl,
                     ModificadoTotalEl;

  mapping for zdm_sol_cab
  {
    IdSolicitud       = id_solicitud;
    Operacion         = operacion;
    Material          = material;
    Sociedad          = sociedad;
    Centro            = centro;
    TipoMaterial      = tipo_material;
    EsBpm             = es_bpm;
    Estado            = estado;
    InicioParalelo    = inicio_paralelo;
    MaterialResultado = material_resultado;
    CreadoPor         = creado_por;
    CreadoEl          = creado_el;
    ModificadoPor     = modificado_por;
    ModificadoEl      = modificado_el;
    ModificadoTotalEl = modificado_total_el;
  }
}

