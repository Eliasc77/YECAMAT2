@EndUserText.label : 'DM: Outbox de integración de material'
@AbapCatalog.enhancement.category : #NOT_EXTENSIBLE
@AbapCatalog.tableCategory : #TRANSPARENT
@AbapCatalog.deliveryClass : #A
@AbapCatalog.dataMaintenance : #RESTRICTED
define table zdm_sol_salida {
  key mandt              : abap.clnt not null;
  key id_solicitud       : sysuuid_x16 not null;
  estado                 : abap.char(12) not null;
  intentos               : abap.int2 not null;
  proximo_intento_el     : timestampl;
  ultimo_intento_el      : timestampl;
  codigo_error           : abap.char(30);
  texto_error            : abap.char(255);
  material_resultado     : abap.char(40);
  modificado_total_el    : abp_locinst_lastchange_tstmpl;
}

