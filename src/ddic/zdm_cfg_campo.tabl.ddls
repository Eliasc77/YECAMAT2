@EndUserText.label : 'DM: Matriz dinámica de campos'
@AbapCatalog.enhancement.category : #NOT_EXTENSIBLE
@AbapCatalog.tableCategory : #TRANSPARENT
@AbapCatalog.deliveryClass : #C
@AbapCatalog.dataMaintenance : #RESTRICTED
define table zdm_cfg_campo {
  key mandt              : abap.clnt not null;
  key sociedad           : abap.char(4) not null;
  key centro             : abap.char(4) not null;
  key tipo_material      : abap.char(4) not null;
  key operacion          : abap.char(1) not null;
  key area               : abap.char(10) not null;
  key campo_tecnico      : abap.char(40) not null;
  etiqueta               : abap.char(80) not null;
  control_campo          : abap.char(10) not null;
  tipo_dato              : abap.char(10) not null;
  orden                  : abap.int2;
  ayuda_valores          : abap.char(30);
  regla_validacion       : abap.char(30);
  activo                 : abap_boolean not null;
  modificado_por         : abp_lastchange_user;
  modificado_el          : abp_lastchange_tstmpl;
  modificado_total_el    : abp_locinst_lastchange_tstmpl;
}

