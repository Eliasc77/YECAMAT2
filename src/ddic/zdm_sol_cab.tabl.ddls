@EndUserText.label : 'DM: Cabecera de solicitud'
@AbapCatalog.enhancement.category : #NOT_EXTENSIBLE
@AbapCatalog.tableCategory : #TRANSPARENT
@AbapCatalog.deliveryClass : #A
@AbapCatalog.dataMaintenance : #RESTRICTED
define table zdm_sol_cab {
  key mandt              : abap.clnt not null;
  key id_solicitud       : sysuuid_x16 not null;
  operacion              : abap.char(1) not null;
  material               : abap.char(40);
  sociedad               : abap.char(4) not null;
  centro                 : abap.char(4) not null;
  tipo_material          : abap.char(4) not null;
  es_bpm                 : abap_boolean;
  estado                 : abap.char(20) not null;
  inicio_paralelo        : timestampl;
  material_resultado     : abap.char(40);
  creado_por             : abp_creation_user;
  creado_el              : abp_creation_tstmpl;
  modificado_por         : abp_lastchange_user;
  modificado_el          : abp_lastchange_tstmpl;
  modificado_total_el    : abp_locinst_lastchange_tstmpl;
}

